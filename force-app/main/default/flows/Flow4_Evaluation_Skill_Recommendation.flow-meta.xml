<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Formation_Trouvee</name>
        <label>Formation Trouvée ?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>non</defaultConnectorLabel>
        <rules>
            <name>oui</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Recuperer_Formation_Liee.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Creer_Recommendation</targetReference>
            </connector>
            <label>oui</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Flow4: Evaluation Skill Recommendation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow4: Evaluation Skill Recommendation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Creer_Recommendation</name>
        <label>Créer Recommendation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Employee__c</field>
            <value>
                <elementReference>$Record.Employee__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority__c</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reason__c</field>
            <value>
                <elementReference>Reason_text</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recommendation_Type__c</field>
            <value>
                <stringValue>Training</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Training__c</field>
            <value>
                <elementReference>Recuperer_Formation_Liee.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Recommendation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Recuperer_Formation_Liee</name>
        <label>Récupérer Formation Liée</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Formation_Trouvee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Skill_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Skill_Name__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Training__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recuperer_Formation_Liee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Skill_Score__c</field>
            <operator>LessThan</operator>
            <value>
                <numberValue>60.0</numberValue>
            </value>
        </filters>
        <object>Skill_Inventory__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>Reason_text</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>Skill score inférieur à 60% - Formation recommandée automatiquement</text>
    </textTemplates>
</Flow>
