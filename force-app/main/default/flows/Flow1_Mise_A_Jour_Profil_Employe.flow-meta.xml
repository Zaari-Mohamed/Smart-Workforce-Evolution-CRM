<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Additionner_Les_Niveaux</name>
        <label>Additionner Les Niveaux</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SommeCurrent</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Boucle_Skills.Current_Level__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SommeTarget</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Boucle_Skills.Target_Level__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Boucle_Skills</targetReference>
        </connector>
    </assignments>
    <description>Calcule et met à jour automatiquement le Skill Match Score de l&apos;employé à chaque modification de son profil</description>
    <environments>Default</environments>
    <formulas>
        <name>SkillMatchScore</name>
        <dataType>Number</dataType>
        <expression>{!SommeCurrent} / {!SommeTarget} * 100</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Flow1 Mise A Jour Profil Employe {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Flow1 Mise A Jour Profil Employe</label>
    <loops>
        <description>Boucle pour calculer SommeCurrent et SommeTarget de tt les skills</description>
        <name>Boucle_Skills</name>
        <label>Boucle Skills</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Recuperer_Skills_Employe</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Additionner_Les_Niveaux</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Mettre_a_jour_Skill_Match_Score</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Recuperer_Skills_Employe</name>
        <label>Récupérer Skills Employé</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Boucle_Skills</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Employee__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Skill_Inventory__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Mettre_a_jour_Skill_Match_Score</name>
        <label>Mettre à jour Skill Match Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Skill_Match_Score__c</field>
            <value>
                <elementReference>SkillMatchScore</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recuperer_Skills_Employe</targetReference>
        </connector>
        <object>Employe__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>SommeCurrent</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>SommeTarget</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
